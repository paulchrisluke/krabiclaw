# Copy this file to .env: the single local configuration for Nuxt, Wrangler,
# setup scripts, and E2E tests. Do not create .dev.vars or a symlink to it.
# Deployed Worker secrets are configured separately through Cloudflare.
NUXT_PUBLIC_PLATFORM_DOMAIN=http://localhost:3000
NUXT_PUBLIC_FREE_ORGANIZATION_DOMAIN=http://localhost:3000
NUXT_PUBLIC_APP_NAME=Krabiclaw
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_HELP_URL=http://localhost:3000/help

# Internal support notification emails (comma-separated recipients for platform alerts/emails)
# This is not used for platform admin authorization.
PLATFORM_OWNER_EMAILS=owner1@example.com,owner2@example.com

# Resend API (for email sending)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Local dev defaults to log_only so a real RESEND_API_KEY above never actually sends mail —
# reservation/contact/booking test data (including e2e seed fixtures) would otherwise bounce
# real emails to fake addresses and burn the sending domain's reputation. Set to "provider"
# only if you deliberately need to test a real Resend send locally.
EMAIL_DELIVERY_MODE=log_only
# Verifies POST /api/resend/webhook (Resend's signing secret, whsec_...). Deployed values are
# Cloudflare secrets on each Worker; locally use a value of your own and sign test events with it.
RESEND_WEBHOOK_SECRET=
# The Product News Segment and Topic in the one Resend account. Deployed values are Cloudflare
# secrets. Nothing syncs Contacts where EMAIL_DELIVERY_MODE is log_only, so local runs leave
# these unset; scripts/sync-resend-product-news.ts takes them from the environment it runs in.
RESEND_PRODUCT_NEWS_SEGMENT_ID=
RESEND_PRODUCT_NEWS_TOPIC_ID=

# Signs/verifies the compact reply address r<type><uuid-without-hyphens><24-char-hmac>@reply.<platform-domain>
# so a customer's email reply to a reservation/contact/experience-booking notification threads
# back onto the right submission (server/utils/reply-address.ts). The compact local part stays
# under the 64-character SMTP limit. No separate domain var — the reply subdomain is always
# reply.<NUXT_PUBLIC_PLATFORM_DOMAIN>.
# Generate a 32-byte base64 secret with: openssl rand -base64 32
EMAIL_REPLY_SECRET=<GENERATE_A_SECRET>

# Better Auth Configuration
BETTER_AUTH_SECRET=generate_with_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000

# Local automated testing
E2E_ALLOW_DEV_ROUTES=true
E2E_DEV_ROUTE_SECRET=generate_with_openssl_rand_base64_32
# Shared password for seeded E2E fixture users when a command requires
# credential sign-in. Playwright generates one automatically when omitted.
E2E_TEST_PASSWORD=
# Password for the local developer account local:setup provisions. Set it to make
# http://localhost:3000/api/dev/login sign you in without retyping anything; leave
# it blank and local:setup mints a throwaway it prints instead.
LOCAL_DEVELOPER_EMAIL=developer@playwright.example
LOCAL_DEVELOPER_PASSWORD=

# Preview mode secret for Nuxt (optional, required only for preview routes)
# Generate a 32-byte base64 secret with: openssl rand -base64 32
PREVIEW_SECRET=<GENERATE_A_SECRET>

# Internal scheduled job/API secret for protected cron-style endpoints.
# Used by protected internal scheduled endpoints.
# Generate a 32-byte base64 secret with: openssl rand -base64 32
CRON_SECRET=<GENERATE_A_SECRET>

# Google OAuth for Better Auth (Login/Signup)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Google Maps (Places API)
GOOGLE_PLACES_API_KEY=

# Better Auth OAuth callback for local development. Production is configured
# separately as https://krabiclaw.com/api/auth/callback/google.

# Signs Meta data-deletion confirmation codes. Integration OAuth tokens are
# Better Auth linked accounts, encrypted with BETTER_AUTH_SECRET.
CONNECTOR_TOKEN_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# Stripe sandbox / canonical operating subscription billing
# Select NEW sandbox acct_1ULcs2RBlJkGOR4x in Stripe Dashboard → Developers → API keys.
# Populate these in your private .env; never paste secrets into chat or commit them.
# The old KrabiClaw test account acct_1SXZfREm0pkzLQDb is a different test scope.
# Required for Stripe tests and billing. These keys must both belong to the SAME sandbox.
STRIPE_SECRET_KEY=
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# REQUIRED for existing Better Auth subscription billing, unchanged and separate:
# snapshot-event destination /api/auth/stripe/webhook (2025-11-17.clover).
# Copy that destination's signing secret, or the local Stripe CLI forwarder's secret.
STRIPE_WEBHOOK_SECRET=

# Stripe Connect Payments (required for full Payments provider tests / acceptance)
# Enable Connect with the Platform business model IN THE SAME sandbox first.
# Sandbox creation or a cus_... test customer alone does not enable Connect.
# Separate Connect Accounts v2 THIN-event destination /api/stripe/connect/webhook.
# Copy that destination's own signing secret; not the subscription signing secret.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Dedicated connected-account SNAPSHOT-event destination /api/stripe/payments/webhook,
# Event rendering version 2026-08-26.dahlia. Outbound Payments/Connect uses
# 2026-09-30.preview for Express Managed Risk; subscription client stays canonical.
# Subscribe to checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_succeeded/failed,
# payment_intent.succeeded/canceled/payment_failed, refund.created/updated/failed,
# and charge.dispute.created/updated/closed. Select connected-account events.
# Copy this destination's own signing secret; do not send Payments to Better Auth.
STRIPE_PAYMENTS_WEBHOOK_SECRET=
# Stripe Dashboard → Settings → Payment methods: parent pmc_... configuration ID
# for this sandbox's Connect application. Enable synchronous card / supported wallets
# only, disable delayed methods. Each merchant's child configuration inherits this
# parent; code resolves and validates the seller-scoped child before Checkout.
STRIPE_PAYMENTS_METHOD_CONFIGURATION=
# Existing NUXT_PUBLIC_PLATFORM_DOMAIN above must be an HTTPS platform origin for
# hosted Checkout return URLs; use an approved HTTPS local tunnel for provider tests.
# No extra account-ID, connected-account-ID, buyer-customer-ID, tax-registration,
# application-fee, FX, shipping, or higher-tier price environment variables are needed.
# Supported financial configuration: Accounts v2 Express Dashboard, platform fees,
# Stripe losses. Hosted onboarding and Radar are required; no liability fallback.
# Merchant Accounts v2 onboarding supplies its own identity/capabilities; tax is
# Stripe-native and enabled only where the merchant has configured registrations.

# Metronome Payments usage billing (required for setup / usage acceptance tests)
# From the intended Metronome test/development workspace's API-key settings.
# Native Metronome Stripe collection must point to the SAME Stripe sandbox.
METRONOME_API_KEY=
# ID of that workspace's USD (cents) Payments rate card: captured-volume SUM at
# 0.01337 per captured USD cent (1.337%), plus actual attributable Stripe-cost SUM
# at 1 per cost cent. Both metrics sum properties.pricing_amount, filter currency USD.
# Volume event type: payments_captured_volume. Cost event types: payments_stripe_cost
# and payments_stripe_cost_adjustment. Include positive late adjustments; native servicing handles
# credits separately when the originating invoice has finalized.
# The tenant's operating Stripe Customer needs invoice_settings.default_payment_method;
# a subscription-only default payment method is insufficient. Better Auth still owns
# the platform subscription; Metronome owns Payments usage rating/invoices.
METRONOME_RATE_CARD_ID=
# Not needed for ordinary non-Payments local work: leave the dedicated Payments /
# Connect / Metronome values empty until testing those integrations. Never substitute
# dummy production values or assume Basic/Starter/Growth grants Payments entitlement.
# GA4 Measurement Protocol — sends Stripe subscription purchases and refunds
# into the GA4 property connected to the platform organization's own Google
# Analytics integration. Create the API secret under
# GA4 Admin → Data Streams → [stream] → Measurement Protocol API secrets.
GA4_API_SECRET=your_measurement_protocol_api_secret_here

# Protects the internal platform-search rebuild endpoint.
PLATFORM_SEARCH_REINDEX_SECRET=generate_with_openssl_rand_base64_32

# Google Analytics & Search Console link the user's Google account through
# Better Auth (linkSocial), on the same GOOGLE_CLIENT_ID/SECRET and the same
# /api/auth/callback/google redirect URI as sign-in, asking for each product's
# scopes as it is connected. Enable the Analytics Admin, Search Console and
# Site Verification APIs on that Google Cloud project.


# Account ID visible in Cloudflare dashboard URL
CF_ACCOUNT_ID=fa3dc6c06433f6b0ea78d95bce23ad91

# Cloudflare for SaaS Custom Hostnames and Zaraz
# krabiclaw.com's zone is production's. Local development and E2E run on a copy
# of production's rows, so a zone id here rewrites production's Zaraz tags and
# custom hostnames. Leave CF_ZONE_ID unset and declare Zaraz absent; setting
# both is a configuration error. Only production sets CF_ZONE_ID.
ZARAZ_ANALYTICS=absent
# CF_ZONE_ID=
# API token scoped to Zone:Custom Hostnames edit/read for the krabiclaw.com zone
CF_CUSTOM_HOSTNAMES_API_TOKEN=your_cloudflare_custom_hostnames_token_here
# Target hostname configured in Cloudflare for SaaS for customer CNAME records
CF_SAAS_CNAME_TARGET=customers.krabiclaw.com

# Cloudflare Images
# Dashboard → Images → API Tokens → create token with Images Edit permission
# CLOUDFLARE_IMAGES_API_TOKEN is deliberately absent outside production. Local,
# E2E, staging and preview run on copies of production's rows, so a token here
# stores into and deletes from production's images. Image uploads and social-card
# generation answer 503 'not configured in this environment, by design' instead.
# Dashboard → Images → Overview → Account Hash (e.g. https://imagedelivery.net/ACCOUNT_HASH)
CLOUDFLARE_IMAGES_VARIANT_BASE=https://imagedelivery.net/your_account_hash

# Cloudflare R2 Media
# Dashboard → R2 → krabiclaw-media → Settings → bind a custom domain for CDN delivery
# Example: media.krabiclaw.com bound to the bucket in R2 settings
MEDIA_BASE_URL=https://media.krabiclaw.com

# Cloudflare Turnstile
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp Business API (Priority 2 — send-only notifications)
# Meta app dashboard → WhatsApp → Getting Started → "Phone number ID" (long numeric ID, not the actual number)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# Meta app dashboard → WhatsApp → Getting Started → "Temporary access token" (starts with EAA...)
# For production: create a System User in Meta Business Manager with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=your_access_token_here
# Meta app dashboard → Webhooks → "Verify token" (generate a 32-byte base64 secret with: openssl rand -base64 32)
WHATSAPP_VERIFY_TOKEN=<GENERATE_A_SECRET>
# Meta app dashboard → Settings → Basic → "App secret" (used for webhook signature verification)
WHATSAPP_APP_SECRET=your_app_secret_here
# Same rationale as EMAIL_DELIVERY_MODE above — defaults to log_only for local dev.
WHATSAPP_DELIVERY_MODE=log_only

# Facebook Pages integration — a Better Auth linked Facebook account.
# Valid OAuth redirect URI in the Meta app: <BETTER_AUTH_URL>/api/auth/callback/facebook
# FACEBOOK_CONFIG_ID is the Facebook Login for Business configuration carrying
# the Page permissions.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CONFIG_ID=

# Instagram Login for professional accounts — its own connection, not derived
# from the Facebook Page; a Better Auth Generic OAuth linked account. Instagram
# only redirects to HTTPS, so there is no localhost callback:
# https://krabiclaw.com/api/auth/callback/instagram
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# GitHub API (for changelog - merged PRs)
# Fine-grained token with Contents:read and Pull requests:read permissions
GITHUB_TOKEN=ghp_your_github_fine_grained_token_here
GITHUB_REPO_OWNER=paulchrisluke
GITHUB_REPO_NAME=krabiclaw

# Generate Better Auth secret:
# openssl rand -base64 32

# Production canary identities
# Use dedicated test identities only (never personal phone/email).
CANARY_BASE_URL=https://krabiclaw.com
CANARY_PHONE_E164=+10000000000
CANARY_ORG_ID=org-demo
CANARY_NOTIFICATION_EMAIL=hello@example.com
CANARY_NOTIFICATION_PHONE_E164=+10000000000
# Dedicated login for read-only Playwright / browser-agent production canaries.
# Use a low-privilege test account — NEVER a PLATFORM_OWNER_EMAILS admin identity,
# since that account can impersonate every tenant user.
# To mint the password on a social-only account: trigger the real
# /api/auth/forget-password flow for CANARY_LOGIN_EMAIL, then set the password
# from the emailed reset link. Do not hand-write a password into the DB.
CANARY_LOGIN_EMAIL=qa-canary@example.com
CANARY_LOGIN_PASSWORD=

# General Cloudflare API token used by wrangler (deployments, D1, R2, Workers).
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

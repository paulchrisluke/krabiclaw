{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "worker",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["dev:worker"],
      "port": 3000
    },
    {
      "name": "worker-verify",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", ".output/server/index.mjs", "--assets", ".output/public", "--local", "--port", "3100", "--live-reload"],
      "port": 3100
    }
  ]
}


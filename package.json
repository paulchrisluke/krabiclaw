{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "engines": {
    "node": "24.18.1"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=6144 nuxi build --preset=cloudflare-module && node patch.cjs && node scripts/check-generated-worker.mjs",
    "check:generated-worker": "node scripts/check-generated-worker.mjs",
    "ai-search:sync": "node --experimental-strip-types scripts/ai-search-sync.ts",
    "ai-search:sync:preview": "node --experimental-strip-types scripts/ai-search-sync.ts --base-url https://preview.krabiclaw.com",
    "ai-search:sync:staging": "node --experimental-strip-types scripts/ai-search-sync.ts --base-url https://staging.krabiclaw.com",
    "ai-search:sync:prod": "node --experimental-strip-types scripts/ai-search-sync.ts --base-url https://krabiclaw.com",
    "ai-search:status:prod": "node --experimental-strip-types scripts/ai-search-status.ts --base-url https://krabiclaw.com",
    "typecheck": "nuxi typecheck",
    "lint": "eslint . --ignore-pattern .agents/ --ignore-pattern .tmp/ --ignore-pattern '**/.tmp/' --ignore-pattern .claude/ --ignore-pattern '**/.claude/' --max-warnings=0",
    "lint:better-auth-boundaries": "node scripts/check-better-auth-boundaries.mjs",
    "lint:product-model": "node scripts/check-product-model-guard.mjs",
    "lint:product-domain": "node scripts/check-product-domain-guard.mjs",
    "lint:social-cards": "node scripts/check-social-card-architecture.mjs",
    "lint:fix": "eslint . --fix --ignore-pattern '.agents/**' --ignore-pattern '.tmp/**' --ignore-pattern '**/.tmp/**' --max-warnings=0",
    "mcp:catalog": "node --experimental-strip-types scripts/check-mcp-tool-catalog.mjs",
    "mcp:catalog:write": "node --experimental-strip-types scripts/check-mcp-tool-catalog.mjs --write",
    "chatgpt:submission:check": "node --experimental-strip-types scripts/generate-chatgpt-app-submission.mjs --check",
    "chatgpt:submission:write": "node --experimental-strip-types scripts/generate-chatgpt-app-submission.mjs --write",
    "platform-locales:check": "node --experimental-strip-types scripts/check-platform-locale-catalog.ts",
    "quality": "yarn lint:better-auth-boundaries && yarn lint:data-loading && yarn lint:test-quality && yarn lint:product-model && yarn lint:product-domain && yarn lint:social-cards && yarn platform-locales:check --locale th && yarn typecheck && yarn lint",
    "lint:data-loading": "node scripts/check-data-loading-guardrails.mjs",
    "lint:test-quality": "node scripts/check-unit-test-quality.mjs",
    "test": "yarn test:unit && yarn test:d1 && yarn test:e2e",
    "test:unit": "node --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs --test tests/unit/**/*.test.ts",
    "test:unit:file": "node --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs --test",
    "test:d1": "node --experimental-strip-types --import ./tests/unit/support/register-aliases.mjs --test tests/integration/*-d1.test.ts",
    "test:migrations": "node --test tests/integration/migration-generation.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test",
    "test:browser": "playwright test --project=chromium --workers=1",
    "test:e2e:tenant-rendering": "playwright test tests/e2e/tenant-rendering.spec.ts tests/e2e/tenant-client-navigation.spec.ts --project=chromium",
    "test:e2e:tenant-localization": "playwright test tests/e2e/tenant-localization.spec.ts --project=chromium --workers=1",
    "test:e2e:guest-journeys": "playwright test tests/e2e/tenant-guest-journeys.spec.ts --project=chromium --workers=1",
    "test:e2e:mcp": "playwright test tests/e2e/mcp-media.spec.ts tests/e2e/mcp-content.spec.ts tests/e2e/mcp-owner-tools.spec.ts tests/e2e/mcp-authorization.spec.ts tests/e2e/oauth-discovery.spec.ts",
    "test:e2e:preview:selected": "node scripts/run-preview-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "cloudflare:resources": "node scripts/check-cloudflare-resources.mjs",
    "dev": "nuxt dev",
    "local:setup": "yarn schema:local && yarn seed:local && node --experimental-strip-types scripts/provision-development-auth.ts --local-dev && yarn fixtures:verify:local --local-dev",
    "dev:worker": "yarn build && yarn dev:worker:start",
    "dev:worker:start": "wrangler dev .output/server/index.mjs --assets .output/public --local --port 3000 --live-reload",
    "fixtures:verify:local": "node --experimental-strip-types scripts/verify-seeded-d1.ts",
    "fixtures:verify:preview": "node --experimental-strip-types scripts/verify-seeded-d1.ts --preview",
    "e2e:local:prepare": "yarn schema:local && node --experimental-strip-types scripts/reset-e2e-artifacts.ts --older-than-hours=0 && yarn seed:local && node --experimental-strip-types scripts/provision-development-auth.ts && yarn build",
    "postinstall": "patch-package --error-on-fail && nuxt prepare",
    "schema:local": "wrangler d1 migrations apply DB --local",
    "drizzle:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:epoch3:transform": "node scripts/epoch3-data.mjs transform",
    "db:epoch3:verify": "node scripts/epoch3-data.mjs verify",
    "db:reset:preview": "node scripts/reset-preview-d1.mjs",
    "seed:demo:generate": "node --experimental-strip-types scripts/generate-demo-seed.ts --stdout > /dev/null && node --experimental-strip-types scripts/generate-demo-bundle.ts",
    "seed:demo:preview": "node --experimental-strip-types scripts/generate-demo-seed.ts --preview",
    "seed:local": "node --experimental-strip-types scripts/generate-demo-seed.ts && node --experimental-strip-types scripts/generate-pottery-house-seed.ts && node --experimental-strip-types scripts/generate-kikuzuki-seed.ts && node --experimental-strip-types scripts/generate-ncls-seed.ts",
    "seed:pottery:generate": "node --experimental-strip-types scripts/generate-pottery-house-seed.ts --stdout > /dev/null",
    "seed:pottery:preview": "node --experimental-strip-types scripts/generate-pottery-house-seed.ts --preview",
    "seed:pottery-local": "node --experimental-strip-types scripts/generate-pottery-house-seed.ts",
    "seed:kikuzuki": "node --experimental-strip-types scripts/generate-kikuzuki-seed.ts",
    "seed:kikuzuki:preview": "node --experimental-strip-types scripts/generate-kikuzuki-seed.ts --preview",
    "client:replay": "node scripts/client-replay.mjs",
    "client:import": "node scripts/client-import.mjs",
    "client:onboard": "node scripts/client-onboard.mjs",
    "client:override": "node scripts/client-override.mjs",
    "client:verify": "node scripts/client-verify.mjs",
    "client:verify:blawby": "node scripts/verify-blawby-site.mjs",
    "client:screenshots:blawby": "node scripts/capture-blawby-screenshots.mjs",
    "client:parity:blawby": "node scripts/compare-blawby-screenshots.mjs",
    "client:deploy": "node scripts/client-deploy.mjs",
    "test:mcp": "node scripts/test-mcp-oauth.mjs",
    "test:mcp:local": "node scripts/check-local-mcp-harness.mjs",
    "test:mcp:local:tunnel": "node --experimental-strip-types scripts/test-mcp-local-tunnel.mjs",
    "test:mcp:auth-registration": "node scripts/check-mcp-auth-registration.mjs",
    "test:mcp:app": "node scripts/check-mcp-app-contract.mjs",
    "test:mcp:edit": "node scripts/check-mcp-edit-flow.mjs",
    "test:mcp:image": "node scripts/check-mcp-image-flow.mjs",
    "test:mcp:ops": "node scripts/check-mcp-ops-flow.mjs",
    "test:mcp:prod": "node scripts/test-mcp-oauth.mjs --base-url https://krabiclaw.com",
    "canary:prod": "node scripts/canary-prod.mjs",
    "canary:notifications": "node scripts/canary-notifications.mjs",
    "canary:status": "node scripts/canary-provider-status.mjs",
    "fixture:pottery-house": "node scripts/fixtures/pottery-house-krabi.fixture.mjs",
    "lint:seeds": "node scripts/lint-seeds.mjs",
    "lint:migrations": "node scripts/lint-migrations.mjs",
    "lint:schema-drift": "node scripts/check-schema-drift.mjs",
    "lint:epoch3-indexes": "node scripts/audit-epoch3-indexes.mjs",
    "audit:media-placements": "node scripts/audit-orphaned-media-placements.mjs",
    "secret:cron": "yarn wrangler secret put CRON_SECRET",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/auth/stripe/webhook",
    "stripe:catalog:plan": "node scripts/seed-stripe.mjs --dry-run",
    "stripe:catalog:apply": "node scripts/seed-stripe.mjs --apply",
    "perf:lighthouse": "node scripts/lighthouse-check.mjs",
    "demo:record:list-devices": "bash scripts/demo-recording/list-avfoundation-devices.sh",
    "demo:record:web": "bash scripts/demo-recording/start-screen-recording.sh",
    "test:mcp:chatgpt": "node --experimental-strip-types scripts/test-mcp-local-tunnel.mjs --chatgpt"
  },
  "//resolutions": "kysely pinned to 0.28.17: @better-auth/kysely-adapter (bundled transitively by better-auth even though this app only uses drizzleAdapter) imports DEFAULT_MIGRATION_TABLE from the top-level kysely package, which kysely 0.29.x stopped re-exporting from its main barrel. That breaks yarn build's Nitro/Rollup bundling pass. Remove this pin once better-auth's kysely-adapter fixes its import path or drops the kysely dependency.",
  "resolutions": {
    "kysely": "0.28.17"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
